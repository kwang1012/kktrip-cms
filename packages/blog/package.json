{
  "name": "@flare-cms/blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "KK Trip content hub powered by EmDash",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check",
    "test": "vitest --run",
    "deploy": "astro build && wrangler deploy",
    "migrate:flare": "tsx scripts/export-flare.ts",
    "types": "wrangler types",
    "seed:validate": "emdash seed seed/seed.json --validate",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@emdash-cms/gutenberg-to-portable-text": "^1.1.0",
    "@portabletext/to-html": "^6.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^6.4.8",
    "emdash": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "eslint": "^9.39.3",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.0.15",
    "wrangler": "^4.147.0"
  },
  "emdash": {
    "seed": "seed/seed.json"
  }
}
