---
import CmsWidgets from './CmsWidgets.astro'
import { t } from '../lib/strings'

interface Props {
  topics: { tag: string; count: number }[]
  /** Active tag; undefined means "all". */
  active?: string
  total: number
}

const { topics, active, total } = Astro.props
const item = 'flex items-center justify-between rounded-lg px-3 py-2 text-[15px] transition-colors'
const on = 'bg-accent-soft font-medium text-accent-deep'
const off = 'text-text-sub hover:bg-card hover:text-text'
---

<aside class="lg:sticky lg:top-24 lg:self-start lg:border-r lg:border-border lg:pr-10">
  <h1 class="font-serif text-3xl font-bold leading-tight tracking-tight lg:text-[2rem]">旅誌</h1>
  <p class="mt-3 max-w-xs text-[15px] leading-7 text-text-sub">{t.siteTagline}</p>

  <nav aria-label={t.topicsHeading} class="mt-8 hidden lg:block">
    <ul class="space-y-0.5">
      <li>
        <a href="/" class:list={[item, active === undefined ? on : off]}>
          <span>{t.allTopics}</span><span class="text-xs tabular-nums opacity-70">{total}</span>
        </a>
      </li>
      {
        topics.map(({ tag, count }) => (
          <li>
            <a href={`/tag/${encodeURIComponent(tag)}`} class:list={[item, tag === active ? on : off]}>
              <span>{tag}</span><span class="text-xs tabular-nums opacity-70">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mt-8"><CmsWidgets name="sidebar" /></div>
</aside>
