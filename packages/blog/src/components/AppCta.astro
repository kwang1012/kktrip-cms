---
import AppStoreBadge from './AppStoreBadge.astro'
import { t } from '../lib/strings'
---

<aside class="rounded-2xl border border-border bg-card p-6 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-8">
  <div>
    <h2 class="font-serif text-xl font-bold tracking-tight">{t.downloadAppTitle}</h2>
    <p class="mt-1.5 text-sm text-text-sub">{t.downloadAppBody}</p>
  </div>
  <AppStoreBadge class="mt-5 sm:mt-0" />
</aside>
