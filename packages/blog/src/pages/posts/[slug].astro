---
import Layout from '../../layouts/Layout.astro'
import ArticleView from '../../components/ArticleView.astro'
import RelatedPosts from '../../components/RelatedPosts.astro'
import { CACHE_CONTROL, loadPosts } from '../../lib/load'
import { relatedPosts } from '../../lib/related'
import { t } from '../../lib/strings'

const { posts, failed } = await loadPosts()
const post = posts.find((p) => p.slug === Astro.params.slug)

if (failed) {
  return new Response(t.loadError, { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8' } })
}
if (!post) return Astro.rewrite('/404')

Astro.response.headers.set('Cache-Control', CACHE_CONTROL)
const related = relatedPosts(post, posts, 3)
---

<Layout title={post.title} description={post.excerpt || undefined} image={post.image} type="article">
  <ArticleView post={post} />
  <RelatedPosts posts={related} />
</Layout>
