---
import Button from './Button.astro'
import CmsMenu from './CmsMenu.astro'
import { navigation } from '../lib/chrome'
import { appLink } from '../lib/site'
import { getStrings } from '../lib/strings'
const t = getStrings(Astro.currentLocale)
const items = await navigation('primary', Astro.currentLocale)
---
<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="grid h-16 grid-cols-[1fr_auto_1fr] items-center px-4 sm:px-6 lg:px-8">
    <a href="https://kktrip.app" class="flex items-center gap-2.5 justify-self-start" aria-label={t.siteName}>
      <img src="/favicon-32x32.png" alt="" width="32" height="32" class="size-8 rounded-lg" />
    </a>
    <nav class="hidden md:block" aria-label="主要導覽"><CmsMenu items={items} /></nav>
    <div class="col-start-3 flex items-center gap-1 justify-self-end">
      <a href={appLink('/login')} target="_blank" rel="noopener noreferrer" class="hidden rounded-lg px-3 py-2 text-sm text-text-sub hover:text-text sm:inline-flex">{t.login}</a>
      <Button href={appLink('/login')} size="sm" class="rounded-lg!">{t.start}</Button>
      <slot />
      <details class="relative md:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg text-text-sub hover:text-text [&::-webkit-details-marker]:hidden" aria-label="選單">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </summary>
        <nav class="absolute right-0 top-full z-50 mt-2 w-64 rounded-xl border border-border bg-card p-2 shadow-lg" aria-label="行動版導覽"><CmsMenu items={items} vertical /></nav>
      </details>
    </div>
  </div>
</header>
