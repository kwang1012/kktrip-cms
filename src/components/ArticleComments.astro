---
import { getCollectionInfo } from 'emdash'
import { Comments, CommentForm } from 'emdash/ui/comments'
interface Props { contentId: string }
const { contentId } = Astro.props
const enabled = (await getCollectionInfo('posts'))?.commentsEnabled ?? false
---
{enabled && <section data-article-comments class="mt-12 border-t border-border pt-8 [--ec-form-user-bg:var(--card)] [--ec-form-user-bg-dark:var(--card)] [--ec-form-user-border:var(--border)] [&_.ec-comment-user-info]:flex-wrap [&_.ec-comment-user-info]:text-text [&_.ec-comment-user-email]:break-all [--ec-form-bg:var(--card)] [--ec-form-border:var(--border)] [--ec-form-color:var(--text)] [--ec-form-submit-bg:var(--accent)] [--ec-form-submit-color:white]">
  <h2 class="font-serif text-2xl font-bold">留言討論</h2>
  <p class="mt-3 mb-6 text-sm leading-6 text-text-sub">分享你的想法。留言審核通過後會公開，電子郵件不會顯示。</p>
  <Comments collection="posts" contentId={contentId} threaded />
  <div class="mt-6"><CommentForm collection="posts" contentId={contentId} /></div>
</section>}
<script>
  const translations: Record<string, string> = {
    Name: '稱呼', Email: 'Email', Comment: '留言',
    'Post Comment': '送出留言', 'Submitting...': '送出中…',
    'No comments yet': '還沒有留言，歡迎開始討論。',
    Reply: '回覆', 'Cancel reply': '取消回覆',
    'Comment submitted for review': '留言已送出，審核通過後會顯示。',
    'Comment submitted!': '留言已送出，審核通過後會顯示。',
  }
  document.querySelectorAll('[data-article-comments]').forEach(section => {
    const localize = () => {
      section.querySelectorAll('span, button, h3, p, [role="status"]').forEach(element => {
        if (element.children.length) return
        const text = element.textContent?.trim() ?? ''
        const count = text.match(/^(\d+) Comments?$/)
        const translated = translations[text] ?? (count ? `${count[1]} 則留言` : undefined)
        if (translated && translated !== text) element.textContent = translated
      })
    }
    localize()
    new MutationObserver(localize).observe(section, { childList: true, subtree: true, characterData: true })
  })
</script>
