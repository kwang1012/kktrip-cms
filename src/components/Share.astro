---
import { getStrings } from '../lib/strings'
const t = getStrings(Astro.currentLocale)

interface Props {
  url: string
  title: string
  class?: string
}

const { url, title, class: className } = Astro.props
const u = encodeURIComponent(url)
const tt = encodeURIComponent(title)
const links = [
  { label: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${tt}`, path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z', viewBox: '0 0 24 24' },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, path: 'M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.931-1.956 1.887v2.263h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z', viewBox: '0 0 24 24' },
]
const line = `https://social-plugins.line.me/lineit/share?url=${u}`
const mail = `mailto:?subject=${tt}&body=${u}`
const btn =
  'inline-flex h-9 w-9 items-center justify-center rounded-full border border-border-strong text-text-sub transition-colors hover:border-text hover:text-text'
---

<div class={className}>
  <p class="mb-3 text-xs font-medium uppercase tracking-widest text-text-sub">{t.shareThis}</p>
  <div class="flex flex-wrap items-center gap-2">
    {
      links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener" aria-label={l.label} class={btn}>
          <svg viewBox={l.viewBox} class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d={l.path} /></svg>
        </a>
      ))
    }
    <a href={line} target="_blank" rel="noopener" aria-label="LINE" class:list={[btn, 'text-[10px] font-bold']}>LINE</a>
    <a href={mail} aria-label="Email" class={btn}>
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
    </a>
    <!-- <button
      type="button"
      data-copy-link
      data-copied={t.copied}
      class="inline-flex h-9 items-center rounded-full border border-border-strong px-3.5 text-sm text-text-sub transition-colors hover:border-text hover:text-text"
    >
      {t.copyLink}
    </button> -->
  </div>
</div>
