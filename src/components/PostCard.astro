---
import { localePath } from '../lib/locales'
import Cover from './Cover.astro'
import Avatar from './Avatar.astro'
import type { Post } from '../lib/post-types'
import { formatDate, readingMinutes } from '../lib/format'
import { getStrings } from '../lib/strings'
const t = getStrings(Astro.currentLocale)

interface Props {
  post: Post
}

const { post } = Astro.props
---

<article class="group">
  <a href={localePath(`/posts/${post.slug}`, post.locale || Astro.currentLocale)} class="block">
    <Cover post={post} />
    {post.tags[0] && <p class="mt-4 text-xs text-text-sub">{post.tags[0]}</p>}
    {post.categories?.length ? <p class="mt-3 text-xs text-accent-deep">{post.categories.map(term => term.label).join(' · ')}</p> : null}
      <h3 class="mt-1.5 font-serif text-[1.375rem] font-bold leading-snug tracking-tight transition-colors group-hover:text-accent-deep">
      {post.title}
    </h3>
    {post.excerpt && <p class="mt-2 line-clamp-3 text-[15px] leading-7 text-text-sub">{post.excerpt}</p>}
    <div class="mt-4 flex items-center gap-2.5 text-sm text-text-sub">
      {post.credits?.[0]?.avatar ? <img src={post.credits[0].avatar} alt="" width="24" height="24" class="size-6 rounded-full object-cover" /> : post.author && <Avatar name={post.author} />}
      <span class="min-w-0 truncate">
        {post.author && <span class="font-medium text-text">{post.author}</span>}
        {post.author && <span aria-hidden="true"> · </span>}
        <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt, post.locale || Astro.currentLocale)}</time>
        <span aria-hidden="true"> · </span>{t.readMin(readingMinutes(post.contentHtml))}
      </span>
    </div>
  </a>
</article>
