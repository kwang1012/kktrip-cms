---
import type { TocItem } from '../lib/toc'
import { t } from '../lib/strings'

interface Props {
  items: TocItem[]
}

const { items } = Astro.props
---

{
  items.length > 1 && (
    <nav aria-label={t.toc} class="text-sm">
      <h2 class="mb-3 text-xs font-medium uppercase tracking-widest text-text-sub">{t.toc}</h2>
      <ol class="space-y-2 border-l border-border">
        {items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-toc-link
              class:list={[
                '-ml-px block border-l border-transparent py-0.5 leading-6 text-text-sub transition-colors hover:text-text',
                item.level === 3 ? 'pl-7' : 'pl-4',
              ]}
            >
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
