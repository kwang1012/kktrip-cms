---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui'
import { createPublicPageContext } from 'emdash/page'
import { siteIdentity } from '../lib/chrome'
import { t } from '../lib/strings'

interface Props {
  content?: { collection: string; id: string; slug?: string }
  articleMeta?: { publishedTime: string; modifiedTime: string; author: string }
  robots?: string | null
  canonical?: string | null
  seoTitle?: string
  title?: string
  description?: string
  image?: string | null
  type?: 'website' | 'article'
}

const { title, description, image = null, type = 'website', content, articleMeta, robots, canonical: customCanonical, seoTitle }  = Astro.props
const identity = await siteIdentity()
const fullTitle = seoTitle || (title ? `${title} · ${identity.title}` : identity.title)
const page = createPublicPageContext({ Astro, kind: content ? 'content' : 'custom', pageType: type,
  title: fullTitle, pageTitle: title || identity.title, description: description || identity.tagline, image, content,
  canonical: customCanonical || new URL(Astro.url.pathname, Astro.site).toString(), seo: { robots }, articleMeta, siteName: identity.title, siteUrl: Astro.site?.origin })
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <EmDashHead page={page} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={t.siteName} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&display=swap"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <EmDashBodyStart page={page} />
    <Header />
    <main class="min-w-0 flex-1">
      <slot />
    </main>
    <Footer />
    <EmDashBodyEnd page={page} />
  </body>
</html>
