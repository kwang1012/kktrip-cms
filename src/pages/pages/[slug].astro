---
import { getEmDashEntry, getSeoMeta } from 'emdash'
import { PortableText } from 'emdash/ui'
import Layout from '../../layouts/Layout.astro'
import { normalizeEmDashPost } from '../../lib/emdash-post'
import { siteIdentity } from '../../lib/chrome'
const slug = decodeURIComponent(Astro.params.slug || '')
const result = await getEmDashEntry('pages', slug)
if (result.error) return new Response('暫時無法載入頁面', { status: 503 })
if (!result.entry) return Astro.rewrite('/404')
const page = normalizeEmDashPost(result.entry, true)
if (!page) return Astro.rewrite('/404')
const identity = await siteIdentity()
const seo = getSeoMeta(result.entry, { siteTitle: identity.title, siteUrl: Astro.site?.origin, path: Astro.url.pathname })
Astro.response.headers.set('Cache-Control', 'private, no-store')
---
<Layout title={page.title} seoTitle={seo.title} description={seo.description || undefined} image={seo.ogImage} canonical={seo.canonical} robots={seo.robots} content={{ collection: 'pages', id: page.id, slug }}>
  <article class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <h1 class="font-serif text-3xl font-bold">{page.title}</h1>
    <div class="prose prose-lg prose-post mt-8 max-w-none"><PortableText value={page.contentBlocks || []} /></div>
  </article>
</Layout>
