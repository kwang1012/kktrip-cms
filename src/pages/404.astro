---
import { localePath } from '../lib/locales'
import Layout from '../layouts/Layout.astro'
import { getStrings } from '../lib/strings'
const t = getStrings(Astro.currentLocale)

Astro.response.status = 404
---

<Layout title={t.notFound}>
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <h1 class="font-serif text-3xl font-bold tracking-tight">{t.notFound}</h1>
    <p class="mt-3 text-text-sub">{t.notFoundBody}</p>
    <a href={localePath('/', Astro.currentLocale)} class="mt-8 inline-block text-accent-deep underline underline-offset-4">{t.allPosts}</a>
  </section>
</Layout>
