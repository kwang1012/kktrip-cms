---
import { siteLocale } from '../../lib/locales'
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../components/Sidebar.astro'
import PostCard from '../../components/PostCard.astro'
import TagList from '../../components/TagList.astro'
import { matchesTag } from '../../lib/editorial'
import { tagCounts } from '../../lib/cms'
import { CACHE_CONTROL, loadPosts } from '../../lib/load'
import { getStrings } from '../../lib/strings'
const t = getStrings(Astro.currentLocale)

const tag = decodeURIComponent(Astro.params.tag ?? '')
const { posts, failed } = await loadPosts(siteLocale(Astro.currentLocale))
if (!failed) Astro.response.headers.set('Cache-Control', CACHE_CONTROL)
const matching = posts.filter((p) => matchesTag(p, tag))
const topics = tagCounts(posts)
---

<Layout title={t.postsTagged(tag)}>
  <div class="mx-auto max-w-[90rem] px-4 pt-12 sm:px-6 sm:pt-16 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:px-8">
    <Sidebar topics={topics} active={tag} total={posts.length} />

    <div class="mt-8 min-w-0 lg:mt-0 lg:pl-12">
      <div class="mb-8 lg:hidden"><TagList tags={topics.map((x) => x.tag)} active={tag} allLabel={t.allTopics} /></div>
      <h2 class="mb-8 font-serif text-3xl font-bold tracking-tight">{tag}</h2>
      {
        failed ? (
          <p class="py-16 text-text-sub">{t.loadError}</p>
        ) : matching.length === 0 ? (
          <p class="py-16 text-text-sub">{t.noPosts}</p>
        ) : (
          <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
            {matching.map((post) => <PostCard post={post} />)}
          </div>
        )
      }
    </div>
  </div>
</Layout>
